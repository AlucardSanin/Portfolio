            break;

        case "x":
            <path fill="currentColor" stroke="none" d="M17.53 3h3.02l-6.6 7.54L21.75 21h-5.94l-4.65-6.08L5.83 21H2.8l7.06-8.07L2.5 3h6.09l4.2 5.56L17.53 3Zm-1.06 16.2h1.67L7.6 4.7H5.81l10.66 14.5Z" />
            break;

        case "mail":
            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
            <path d="m3.5 7 7.36 5.24a2 2 0 0 0 2.28 0L20.5 7" />
            break;

        case "external":
            <path d="M13.5 4.5h6v6" />
            <path d="M19.5 4.5 10 14" />
            <path d="M18 14.5v3.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.5" />
            break;

        case "arrow-right":
            <path d="M4.5 12h15" />
            <path d="m13.5 6 6 6-6 6" />
            break;

        case "arrow-down":
            <path d="M12 4.5v15" />
            <path d="m6 13.5 6 6 6-6" />
            break;

        case "arrow-up":
            <path d="M12 19.5v-15" />
            <path d="m6 10.5 6-6 6 6" />
            break;

        case "menu":
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h10" />
            break;

        case "close":
            <path d="M6 6l12 12" />
            <path d="M18 6 6 18" />
            break;

        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
