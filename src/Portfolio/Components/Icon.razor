        case "moon":
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
            break;

        case "copy":
            <rect x="9" y="9" width="11" height="11" rx="2.5" />
            <path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H6.5A2.5 2.5 0 0 0 4 5.5v6A2.5 2.5 0 0 0 6.5 14" />
            break;

        case "check":
            <path d="m5 12.5 4.5 4.5L19 7" />
            break;

        case "layers":
            <path d="m12 3 9 4.5-9 4.5L3 7.5 12 3Z" />
            <path d="m3 12 9 4.5L21 12" />
            <path d="m3 16.5 9 4.5 9-4.5" />
            break;

        case "bolt":
            <path d="M13.5 2 4 13.5h6.5L10 22l9.5-11.5H13L13.5 2Z" />
            break;

        case "phone":
            <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
            <path d="M10.5 18.5h3" />
            break;

        case "card":
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 10h19" />
            <path d="M6.5 15h3" />
            break;

        case "sparkle":
            <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z" />
            <path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z" />
            break;

        case "server":
            <rect x="3" y="4" width="18" height="7" rx="2" />
            <rect x="3" y="13" width="18" height="7" rx="2" />
            <path d="M7 7.5h.01M7 16.5h.01" />
            break;

        case "code":
            <path d="m9 7-5 5 5 5" />
            <path d="m15 7 5 5-5 5" />
            break;

        case "map-pin":
            <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
            break;

        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "code";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
