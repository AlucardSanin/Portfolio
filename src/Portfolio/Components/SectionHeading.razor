<header class="heading" data-reveal>
    <p class="heading__kicker">
        <span class="heading__index">@Index</span>
        <span class="heading__line" aria-hidden="true"></span>
        @Kicker
    </p>
    <h2 class="heading__title">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <p class="heading__lead">@Lead</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Index { get; set; } = "01";
    [Parameter, EditorRequired] public string Kicker { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Lead { get; set; }
}
