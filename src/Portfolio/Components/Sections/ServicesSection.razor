<section class="section section--services" id="services">
    <div class="container">
        <SectionHeading Index="05"
                        Kicker="Services"
                        Title="What you get when you hire me"
                        Lead="Pick the one that sounds like your problem. Usually it is two of them at once." />

        <div class="services">
            @foreach (var service in SiteData.Services)
            {
                <article class="service" data-reveal data-tilt>
                    <span class="service__icon"><Icon Name="@service.Icon" Size="22" /></span>
                    <h3>@service.Title</h3>
                    <p>@service.Body</p>
                </article>
            }
        </div>
    </div>
</section>
