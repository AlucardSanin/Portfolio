<section class="section section--stack" id="stack">
    <div class="container">
        <SectionHeading Index="03"
                        Kicker="Stack"
                        Title="The tools, and what I actually do with them"
                        Lead="Not a logo wall. This is the set I reach for, grouped by the job it does." />

        <div class="stack-grid">
            @foreach (var group in SiteData.Stack)
            {
                <article class="stack-card" data-reveal data-tilt>
                    <header class="stack-card__head">
                        <h3>@group.Title</h3>
                        <p>@group.Caption</p>
                    </header>
                    <ul class="chips">
                        @foreach (var item in group.Items)
                        {
                            <li class="chip">@item</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>
