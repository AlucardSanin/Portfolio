<section class="section section--journey" id="journey">
    <div class="container">
        <SectionHeading Index="04"
                        Kicker="Journey"
                        Title="From my first &lt;div&gt; to production .NET"
                        Lead="Four chapters, one direction: closer to the problem, deeper in the stack." />

        <ol class="timeline">
            @foreach (var entry in SiteData.Timeline)
            {
                <li class="timeline__item" data-reveal>
                    <div class="timeline__marker" aria-hidden="true"><span></span></div>
                    <div class="timeline__card" data-tilt>
                        <p class="timeline__period">@entry.Period</p>
                        <h3 class="timeline__title">@entry.Title</h3>
                        <p class="timeline__place">@entry.Place</p>
                        <p class="timeline__body">@entry.Body</p>
                        <ul class="chips chips--tight">
                            @foreach (var tag in entry.Tags)
                            {
                                <li class="chip">@tag</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>
