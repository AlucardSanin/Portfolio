<section class="section section--journey" id="journey">
    <div class="container">
        <SectionHeading Index="04"
                        Kicker="Experience"
                        Title="Where I have been shipping"
                        Lead="Three years of production .NET for the Swiss hospitality industry, on top of a software engineering degree and 1,300 hours of deliberate practice." />

        <ol class="timeline">
            @foreach (var entry in SiteData.Timeline)
            {
                <li class="timeline__item" data-reveal>
                    <div class="timeline__marker" aria-hidden="true"><span></span></div>
                    <div class="timeline__card">
                        <p class="timeline__period">@entry.Period</p>
                        <h3 class="timeline__title">@entry.Title</h3>
                        <p class="timeline__place">@entry.Place</p>
                        <p class="timeline__body">@entry.Body</p>

                        @if (entry.Achievements.Count > 0)
                        {
                            <ul class="timeline__achievements">
                                @foreach (var achievement in entry.Achievements)
                                {
                                    <li>
                                        <Icon Name="check" Size="15" />
                                        <span>@achievement</span>
                                    </li>
                                }
                            </ul>
                        }

                        <ul class="chips chips--tight">
                            @foreach (var tag in entry.Tags)
                            {
                                <li class="chip">@tag</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>

        <div class="education" data-reveal>
            <h3 class="education__title">Education</h3>
            <div class="education__grid">
                @foreach (var entry in SiteData.Education)
                {
                    <EducationCard Entry="entry" />
                }
            </div>
        </div>
    </div>
</section>
